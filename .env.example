RELAYVIA_ENVIRONMENT=development
RELAYVIA_DATABASE_URL=mysql+pymysql://relayvia:relayvia@127.0.0.1:3306/relayvia
RELAYVIA_CORS_ORIGINS=http://localhost:5173
RELAYVIA_CREDENTIAL_ENCRYPTION_KEY=TnwmzeqQ-XffnsD3s2PF6VG4mBIeGltKpC_iuQCyg-M=
# Generate unique values before first use. Empty values make protected APIs
# unavailable instead of silently running unauthenticated.
RELAYVIA_CONTROL_PLANE_TOKEN=
RELAYVIA_RUNNER_ENROLLMENT_TOKEN=
# Enable only for trusted local/edge development where HTTP capabilities use
# localhost or private-network addresses.
RELAYVIA_ALLOW_PRIVATE_NETWORK_URLS=false
# Independent Worker / Runner task slots. Keep Runner concurrency at 1 for
# shared local repositories; worktree-backed jobs can safely use a higher value.
RELAYVIA_WORKER_CONCURRENCY=4
RELAYVIA_RUNNER_CONCURRENCY=2
# A Runner needs an operator-provided sandbox wrapper. For a trusted local
# developer machine only, explicitly opt in to unsandboxed execution instead.
RELAYVIA_RUNNER_SANDBOX_COMMAND=
RELAYVIA_RUNNER_ALLOW_UNSANDBOXED_EXECUTION=false
# local requires API and Worker to share this durable filesystem. For multiple
# hosts use S3/MinIO-compatible object storage and the normal boto3 credentials
# chain (for example workload identity or AWS_ACCESS_KEY_ID).
RELAYVIA_ARTIFACT_STORAGE_BACKEND=local
RELAYVIA_ARTIFACT_STORAGE_DIR=data/artifacts
RELAYVIA_ARTIFACT_S3_BUCKET=
RELAYVIA_ARTIFACT_S3_PREFIX=relayvia/artifacts
RELAYVIA_ARTIFACT_S3_REGION=
RELAYVIA_ARTIFACT_S3_ENDPOINT_URL=
